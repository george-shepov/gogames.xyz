# GoGames.XYZ Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ── Server ──────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGIN=https://www.gogames.xyz,https://gogames.xyz

# ── Stripe utility-credit purchases ─────────────────────────
# GGX purchased here is non-withdrawable utility credit. It is not a reward,
# cash equivalent, wager balance, or proof of reward eligibility.
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# ── Server-verified rewards ──────────────────────────────────
# off    = no reward sessions
# review = verified sessions and claims, but no payout dispatch
# live   = verified sessions + manual approval + signed payout webhook
REWARDS_MODE=off

# These secrets must be generated independently and stored only on the server.
# Example: openssl rand -base64 48
REWARDS_IDENTITY_SECRET=replace-with-48-random-bytes
REWARDS_SESSION_SECRET=replace-with-48-random-bytes
REWARDS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
REWARDS_PAYOUT_WEBHOOK_SECRET=replace-with-48-random-bytes

# Required in review/live mode. The file is atomically written with mode 0600.
REWARDS_DATA_FILE=/var/lib/gogames/rewards.json

# Live mode only. The payout service must honor Idempotency-Key and verify
# X-GoGames-Signature (HMAC SHA-256 of the raw JSON request body).
REWARDS_PAYOUT_WEBHOOK_URL=https://rewards-provider.example.com/gogames/payouts

# Explicit allowlist. Empty means nobody is eligible.
# Legal/compliance review is required before adding any jurisdiction.
REWARDS_ALLOWED_JURISDICTIONS=US-OH
REWARDS_TERMS_VERSION=2026-01

# First server-authoritative verifier: math-sprint-v1
REWARDS_CURRENCY=GGX
REWARDS_MATH_SPRINT_QUESTION_COUNT=20
REWARDS_MATH_SPRINT_MIN_SCORE=1700
REWARDS_MATH_SPRINT_REWARD_AMOUNT=10
REWARDS_DAILY_CAP=100
REWARDS_SESSION_TTL_MS=600000
REWARDS_MIN_ANSWER_INTERVAL_MS=180
REWARDS_MAX_IDENTITY_TTL_MS=3600000
