# GoGames.XYZ Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ── Server ──────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGIN=https://www.gogames.xyz,https://gogames.xyz

# ── Stripe play-credit purchases ────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# ── Payout compliance gate ──────────────────────────────────
# Generate each value independently, for example:
# openssl rand -base64 48
COMPLIANCE_SERVICE_KEY=replace-with-a-long-random-secret
PAYOUT_ADMIN_KEY=replace-with-a-different-long-random-secret
PAYOUT_PROVIDER_KEY=replace-with-a-third-long-random-secret

# Explicitly allow only reviewed payout rails.
PAYOUT_ASSET_NETWORK_ALLOWLIST=USDC:base,USDC:solana

# Payout requests above this amount (USD minor units) are rejected.
# 100000 = $1,000.00
MAX_PAYOUT_MINOR=100000

# Safe default. Keep false until the production database, licensed payout
# provider/custody integration, legal approvals, and operational controls exist.
REAL_VALUE_PAYOUTS_ENABLED=false
PAYOUT_PROVIDER_MODE=disabled
